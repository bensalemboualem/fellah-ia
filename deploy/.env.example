# ===========================================
# Fellah IA — VPS Configuration
# Domain: fellah.iafactoryalgeria.com
# Copier ce fichier en .env et remplir les valeurs
# ===========================================

# Domaine
DOMAIN=fellah.iafactoryalgeria.com

# GitHub Container Registry (ton username GitHub)
GHCR_USER=bensalemboualem

# Database
LOBE_DB_NAME=fellah_ia
POSTGRES_PASSWORD=              # openssl rand -base64 24

# MinIO / S3
MINIO_ROOT_USER=fellah_admin
MINIO_ROOT_PASSWORD=            # openssl rand -base64 24
MINIO_LOBE_BUCKET=fellah-files

# Auth Secrets (generer avec: openssl rand -base64 32)
KEY_VAULTS_SECRET=              # openssl rand -base64 32
AUTH_SECRET=                    # openssl rand -base64 32

# SSO Providers (casdoor est integre, ajouter google/github si configure)
AUTH_SSO_PROVIDERS=casdoor

# Google OAuth (optionnel — callback: https://fellah.iafactoryalgeria.com/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# GitHub OAuth (optionnel — callback: https://fellah.iafactoryalgeria.com/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# AI Providers (remplir ceux que vous utilisez)
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
TOGETHERAI_API_KEY=
OPENROUTER_API_KEY=

# Ollama (mettre 1 si ollama installe sur le VPS)
ENABLED_OLLAMA=0
OLLAMA_PROXY_URL=

# Default Agent
DEFAULT_AGENT_CONFIG=model=deepseek-chat;provider=deepseek

# RAG
DEFAULT_FILES_CONFIG=embedding_model=openrouter/openai/text-embedding-3-small,query_mode=hybrid,reranker_model=openrouter/jina/jina-reranker-v1-base-en
